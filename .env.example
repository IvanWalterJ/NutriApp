# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ANTHROPIC_API_KEY: Required for /api/normalize-excel (mapeo de planillas con
# Claude Sonnet 4.6). En producción se configura en Vercel. En local solo es
# necesaria si NO usás VITE_PROD_API_URL (ver abajo).
ANTHROPIC_API_KEY=""

# VITE_PROD_API_URL: Si la seteás (ej. https://nutriapp.vercel.app), todas las
# llamadas /api/* del dev server se proxean a producción en vez de ejecutarse
# localmente. Útil cuando ANTHROPIC_API_KEY solo vive en Vercel y no querés
# copiarla a .env.local. Dejar vacía para usar el plugin dev local.
VITE_PROD_API_URL=""
